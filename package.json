{
  "name": "saiki-ia",
  "version": "0.1.0",
  "private": true,
  "description": "saiki-ia - orquestador personal de agentes IA con LangGraph.js.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "manual:kiro": "tsx src/manual/kiro-integration.ts",
    "manual:claude": "tsx src/manual/claude-integration.ts",
    "manual:tech": "tsx src/manual/tech-integration.ts",
    "manual:dev": "tsx src/manual/tech-integration.ts",
    "manual:review": "tsx src/manual/tech-integration.ts",
    "manual:e2e": "tsx src/manual/e2e-integration.ts",
    "manual:moderator": "tsx src/manual/moderator-integration.ts",
    "serve": "tsx src/api/serve.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.5.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
